# Local integrated mode uses the admin app's secured mobile API. Omit all
# three values for the isolated on-device demonstration mode.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# For an Android emulator, use http://10.0.2.2:3000/api. A physical phone
# needs the development computer's LAN address.

# Preview and production builds must explicitly set EXPO_PUBLIC_APP_ENV,
# explicitly disable demo mode, and provide an approved public HTTPS API URL.
# Configure that URL in the build environment; do not commit a production
# endpoint or credentials to this file.

# The assistant is reached through the secured API base URL above. Never place
# a Gemini API key in an EXPO_PUBLIC_* variable or ship it in the client bundle.
