{
  "name": "parishlink-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "config:check": "expo config --type public",
    "export:all": "expo export --platform all --output-dir dist-release-check --clear",
    "release:check": "node ./scripts/release-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "babel-preset-expo": "~58.0.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
