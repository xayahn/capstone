{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "db:generate": "drizzle-kit generate",
    "db:validate": "node scripts/validate-migration.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "probe:local": "node scripts/local-runtime-probe.mjs",
    "test:accounts:local": "node scripts/check-account-local.mjs",
    "test:accounts:worker": "node scripts/check-account-worker.mjs",
    "test:accounts:runner": "node --test scripts/tests/check-account-local.test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test:security": "node scripts/security-regression.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@cloudflare/workers-types": "5.20260730.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "react-server-dom-webpack": "19.2.8",
    "react-test-renderer": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.1.6",
    "vitest": "4.1.12",
    "wrangler": "4.116.0"
  },
  "type": "module"
}
